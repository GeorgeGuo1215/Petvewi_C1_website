{
  "name": "pethealai_website",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "node scripts/copy-reviewer.mjs && next build",
    "build:pages": "node scripts/build-pages.mjs",
    "test:reviewer": "pnpm --dir tools/imu-video-reviewer test",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "dev": "node scripts/copy-reviewer.mjs && next dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
