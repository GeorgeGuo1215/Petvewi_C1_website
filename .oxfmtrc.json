{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": {
    "stylesheet": "./src/app/globals.css"
  },
  "ignorePatterns": [
    ".next/**",
    ".pnpm-store/**",
    "artifacts/**",
    "node_modules/**",
    "out/**",
    "public/**",
    "pnpm-lock.yaml",
    "docs/PetHealthAI_官网现有内容归档.md"
  ]
}
